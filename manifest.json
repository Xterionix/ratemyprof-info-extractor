{
  "manifest_version": 3,
  "name": "Rate My Professors Markdown Exporter",
  "version": "1.0.0",
  "description": "Export a Rate My Professors profile and all loaded reviews as Markdown.",
  "permissions": [
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "https://www.ratemyprofessors.com/*",
    "https://ratemyprofessors.com/*"
  ],
  "action": {
    "default_title": "Export Rate My Professors page",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.ratemyprofessors.com/*",
        "https://ratemyprofessors.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
